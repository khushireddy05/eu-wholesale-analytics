  <worksheets>
    <worksheet name='KPI Summary'>
      <layout-options><title><formatted-text><run bold='true' fontcolor='#183B56' fontsize='14'>Executive snapshot</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption='EU Wholesale Dashboard' name='dashboard_data' /></datasources>
          <datasource-dependencies datasource='dashboard_data'><column datatype='string' name='[view_type]' role='dimension' type='nominal' caption='View Type' />
<column datatype='string' name='[category]' role='dimension' type='nominal' caption='Category' />
<column datatype='real' name='[value]' role='measure' type='quantitative' aggregation='Sum' caption='Value' />
<column datatype='integer' name='[metric_order]' role='dimension' type='ordinal' caption='Metric Order' /></datasource-dependencies>
          <filter class='categorical' column='[dashboard_data].[view_type]'><groupfilter function='member' level='[view_type]' member='&quot;KPI&quot;' /></filter>
          <slices><column>[dashboard_data].[view_type]</column></slices><aggregation value='true' />
        </view>
        <style><style-rule element='worksheet'><format attr='color' value='#FFFFFF' /></style-rule><style-rule element='axis'><format attr='color' value='#486581' /></style-rule></style>
        <panes><pane><view><breakdown value='auto' /></view><mark class='Text' /><encodings><text column='[dashboard_data].[value]' /></encodings></pane></panes>
        <rows>[dashboard_data].[category]</rows><cols>[dashboard_data].[value]</cols>
      </table>
    </worksheet>
